{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signatureworksbd",
  // Client Cloudflare account (Signatureworksbd). Pinned so deploys never go to a personal account.
  "account_id": "91db861cf9a54e287c59674d23d7eb42",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Cloudflare Images powers next/image resizing + WebP/AVIF (free tier: 5,000 unique transforms/month).
  "images": { "binding": "IMAGES" },
  // Self-reference used by OpenNext for cache revalidation.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "signatureworksbd" }],

  // Create once with:
  //   npx wrangler kv namespace create NEXT_INC_CACHE_KV
  //   npx wrangler kv namespace create NEXT_TAG_CACHE_KV
  // then paste the returned ids below.
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "729e32f87a9e4db9aebf02544e312b09" },
    { "binding": "NEXT_TAG_CACHE_KV", "id": "4ea802564aee4154a9fb4769427fce43" }
  ],

  // Public, non-secret values. Secrets are set with `npx wrangler secret put <NAME>`:
  //   SUPABASE_SERVICE_ROLE_KEY, ADMIN_SECRET, ADMIN_PASSWORD, EMAILJS_PRIVATE_KEY
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://apszauqnmlvbomkrlsjn.supabase.co"
  },

  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "signatureworks.com.bd", "custom_domain": true },
    { "pattern": "www.signatureworks.com.bd", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
