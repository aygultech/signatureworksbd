{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signatureworksbd",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Cloudflare Images powers next/image resizing + WebP/AVIF (free tier: 5,000 unique transforms/month).
  "images": { "binding": "IMAGES" },
  // Self-reference used by OpenNext for cache revalidation.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "signatureworksbd" }],

  // Create once with:
  //   npx wrangler kv namespace create NEXT_INC_CACHE_KV
  //   npx wrangler d1 create signatureworksbd-tag-cache
  // then paste the returned ids below.
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "signatureworksbd-tag-cache",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],

  // Public, non-secret values. Secrets are set with `npx wrangler secret put <NAME>`:
  //   SUPABASE_SERVICE_ROLE_KEY, ADMIN_SECRET, ADMIN_PASSWORD, EMAILJS_PRIVATE_KEY
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://knlfouwcjeifrrqmxrig.supabase.co"
  },

  "observability": { "enabled": true }
}
