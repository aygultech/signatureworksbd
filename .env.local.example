# Copy to .env.local for local development (never commit .env.local).
# In production these are set in Cloudflare (see DEPLOY.md).

# --- Public (shipped to the browser; safe to expose) ---
NEXT_PUBLIC_SUPABASE_URL=https://knlfouwcjeifrrqmxrig.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_BOOKING_TEMPLATE_ID=

# --- Server secrets (never prefix with NEXT_PUBLIC_) ---
# Supabase Dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=
# Random, >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SECRET=
# Only used once, to create the first super admin when no admin exists. >= 12 chars.
ADMIN_PASSWORD=
# EmailJS -> Account -> API keys -> Private key (enable "non-browser applications" in Security)
EMAILJS_PRIVATE_KEY=
EMAILJS_RESET_TEMPLATE_ID=
